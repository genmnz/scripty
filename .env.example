# ── Required ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── What to search ────────────────────────────────────────────────────────────
# Comma-separated keywords
SEARCH_TERMS=yourproject,yourbrand,competitor

# ── Where to search ───────────────────────────────────────────────────────────
# Any combination of: github, twitter, reddit, web
PLATFORMS=github,twitter,reddit,web

# ── Timing ────────────────────────────────────────────────────────────────────
# How often to check (minutes)
CHECK_INTERVAL_MINUTES=15

# How far back to look on each cycle (hours)
LOOKBACK_HOURS=24

# ── Optional ──────────────────────────────────────────────────────────────────
# GitHub personal access token — free, gives 3x more API quota
# Create at: https://github.com/settings/tokens (no scopes needed for public search)
GITHUB_TOKEN=

# Path to the SQLite dedup database
# On Fly.io use /data/seen.db (mounted volume), elsewhere default is fine
DB_PATH=seen.db
